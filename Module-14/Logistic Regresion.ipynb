     "output_type": "display_data"
    }
   ],
   "source": [
    "z = np.arange(-10, 11, 0.1)\n",
    "\n",
    "values = sigmoid(z)\n",
    "\n",
    "plt.plot(z, values)\n",
    "\n",
    "plt.xlabel(\"Z\")\n",
    "plt.ylabel(\"Sigmoid(Z)\")"
   ]
